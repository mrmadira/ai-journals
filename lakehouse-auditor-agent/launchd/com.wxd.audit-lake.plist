<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Runs the audit every weekday at 07:00. Install:
       cp launchd/com.wxd.audit-lake.plist ~/Library/LaunchAgents/
       launchctl load ~/Library/LaunchAgents/com.wxd.audit-lake.plist
     Run once now to test:  launchctl start com.wxd.audit-lake
     Remove:                launchctl unload ~/Library/LaunchAgents/com.wxd.audit-lake.plist -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.wxd.audit-lake</string>
  <key>ProgramArguments</key>
  <array><string>/Users/mrudulamadiraju/WORK/wxd-mcp-trial/agents/auditor/audit-lake</string><string>run</string></array>
  <key>EnvironmentVariables</key>
  <dict><key>AUDIT_NOTIFY</key><string>macos</string></dict>
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>7</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>7</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>7</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>7</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>7</integer><key>Minute</key><integer>0</integer></dict>
  </array>
  <key>StandardOutPath</key><string>/Users/mrudulamadiraju/WORK/wxd-mcp-trial/agents/auditor/logs/launchd.out.log</string>
  <key>StandardErrorPath</key><string>/Users/mrudulamadiraju/WORK/wxd-mcp-trial/agents/auditor/logs/launchd.err.log</string>
</dict>
</plist>
