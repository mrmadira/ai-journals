#!/usr/bin/env bash
# lake-brief - the agentic workflow: a fixed 6-step lakehouse brief (audit → select → assess → summarize → validate → publish).
#
#   lake-brief            # reuse the latest audit if < 24h old, else run one
#   lake-brief --fresh    # always run a new audit first
#
# Exit codes: 0 = clean, 2 = something to decide, 1 = failed.
#
# Needs the same credentials as the specialists (it starts them as separate processes).
set -euo pipefail

AGENT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
SETTINGS="$HOME/.claude/settings.json"

for var in AWS_BEARER_TOKEN_BEDROCK AWS_REGION; do
  if [[ -z "${!var:-}" && -f "$SETTINGS" ]] && command -v jq >/dev/null; then
    val="$(jq -r --arg v "$var" '.env[$v] // empty' "$SETTINGS")"
    [[ -n "$val" ]] && export "$var=$val"
  fi
  [[ -n "${!var:-}" ]] || { echo "lake-brief: $var is not set" >&2; exit 1; }
done
[[ -n "${WXD_AUTH:-}" ]] || { echo "lake-brief: WXD_AUTH is not set (the analyst and auditor need it)" >&2; exit 1; }

exec uv run --quiet --project "$AGENT_DIR" python "$AGENT_DIR/workflow.py" "$@"
